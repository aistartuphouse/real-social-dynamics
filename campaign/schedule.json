    "unsubscribe": "one-click (RFC 8058 List-Unsubscribe-Post) + visible footer link; honored immediately, no login",
    "sendingRamp": "start with lawful, engaged segment; expand only if Google-reported spam rate stays < 0.1%; halt before 0.3%",
    "noFakeReplyPrefixes": true
  },
